generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  fullName           String
  age                Int
  gender             Gender
  email              String              @unique
  passwordHash       String
  contactNumber      String?
  role               UserRole            @default(PATIENT)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  appointmentActions AppointmentAction[]
  appointments       Appointment[]
  labResults         LabResult[]
  notifications      Notification[]

  @@map("users")
}

model Service {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String        @db.Text
  icon         String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  appointments Appointment[]

  @@map("services")
}

model AppointmentSlot {
  id           String        @id @default(cuid())
  date         DateTime      @db.Date
  startTime    String
  endTime      String
  capacity     Int
  bookedCount  Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  appointments Appointment[]

  @@unique([date, startTime, endTime])
  @@index([date])
  @@map("appointment_slots")
}

model Appointment {
  id        String              @id @default(cuid())
  userId    String
  serviceId String
  slotId    String
  notes     String?             @db.Text
  status    AppointmentStatus   @default(BOOKED)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  actions   AppointmentAction[]
  service   Service             @relation(fields: [serviceId], references: [id])
  slot      AppointmentSlot     @relation(fields: [slotId], references: [id])
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serviceId])
  @@index([slotId])
  @@map("appointments")
}

model AppointmentAction {
  id            String                @id @default(cuid())
  userId        String
  appointmentId String
  type          AppointmentActionType
  createdAt     DateTime              @default(now())
  appointment   Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([appointmentId])
  @@index([userId, createdAt])
  @@map("appointment_actions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model LabResult {
  id           String          @id @default(cuid())
  userId       String
  testName     String
  dateReleased DateTime?       @db.Date
  status       LabResultStatus @default(PENDING)
  fileUrl      String?
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lab_results")
}

enum UserRole {
  PATIENT
  STAFF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

enum LabResultStatus {
  PENDING
  READY
}

enum AppointmentActionType {
  CANCELLED
  RESCHEDULED
}
